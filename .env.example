NOTION_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DROPBOX_ROOT=
MI_CODE_LIBRARY_ROOT=
NOTION_PROJECTS_DATA_SOURCE_ID=
NOTION_SCHEDULE_DATA_SOURCE_ID=
MI_CODEX_BIN=
MI_CLAUDE_BIN=
