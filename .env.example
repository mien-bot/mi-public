# Remote iPhone/PWA access stays disabled unless every value is configured.
# Keep the Next.js origin on 127.0.0.1 and publish it only through a named
# Cloudflare Tunnel protected by a matching Access application.
MI_REMOTE_ACCESS=0
MI_REMOTE_HOSTNAME=
MI_CLOUDFLARE_ACCESS_TEAM_DOMAIN=
MI_CLOUDFLARE_ACCESS_AUD=
MI_REMOTE_ALLOWED_EMAILS=
# Exact approved project slugs per email; absent/empty grants expose no project data.
MI_REMOTE_PROJECT_GRANTS={}
